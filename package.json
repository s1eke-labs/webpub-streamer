{
  "name": "@s1eke/webpub-streamer",
  "version": "0.0.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s1eke-labs/webpub-streamer"
  },
  "homepage": "https://github.com/s1eke-labs/webpub-streamer",
  "bugs": {
    "url": "https://github.com/s1eke-labs/webpub-streamer/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "npm run build",
    "test:integration": "playwright test"
  },
  "peerDependencies": {
    "@edrlab/thorium-web": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@edrlab/thorium-web": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edrlab/thorium-web": "^1.3.0",
    "@playwright/test": "^1.59.1",
    "@types/css-tree": "^2.3.11",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-ali": "^16.6.0",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.9",
    "ajv": "^8.18.0",
    "css-tree": "^3.2.1",
    "fast-xml-parser": "^5.6.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3"
  }
}
