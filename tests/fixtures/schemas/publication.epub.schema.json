{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s1eke.dev/schemas/publication.epub.schema.json",
  "type": "object",
  "required": ["conformsTo", "readingOrder"],
  "properties": {
    "conformsTo": {
      "type": "array",
      "contains": {
        "const": "https://readium.org/webpub-manifest/profiles/epub"
      }
    },
    "readingOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["href", "type"],
        "properties": {
          "href": {
            "type": "string"
          },
          "type": {
            "const": "application/xhtml+xml"
          }
        }
      }
    }
  }
}
